<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 8.0 – 11 (API 26–30). Android 12+ uses
  data_extraction_rules.xml instead and ignores this file.

  This is an allowlist: once an <include> is present, ONLY what it lists is backed up.
  Settings are included; everything else — in particular the personal dictionaries
  under files/engines/ (learned words, bigrams, saved phrases) — is excluded by
  omission and stays on the device.
-->
<full-backup-content>
    <include domain="sharedpref" path="settings.xml" />
</full-backup-content>
