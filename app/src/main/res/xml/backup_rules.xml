<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 8.0 – 11 (API 26–30). Android 12+ uses
  data_extraction_rules.xml instead and ignores this file.

  Only settings are backed up. The personal dictionaries — learned words, learned
  bigrams and saved phrases under files/engines/ — are the user's writing habits and
  stay on the device. Naming both sides keeps the intent explicit even though an
  <include> alone would already limit backup to what it lists.
-->
<full-backup-content>
    <include domain="sharedpref" path="settings.xml" />
    <exclude domain="file" path="engines" />
</full-backup-content>
